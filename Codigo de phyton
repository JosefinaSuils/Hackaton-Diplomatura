import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from matplotlib.ticker import FuncFormatter

# 1. Cargar los datos (asumiendo que los archivos CSV han sido subidos a Colab)
# Los archivos CSV con las longitudes calculadas son 'hg38_chromosome_lengths.csv' y 't2t_chromosome_lengths.csv'
df_hg38 = pd.read_csv("hg38_chromosome_lengths.csv").rename(columns={'Length': 'Hg38_Length'})
df_t2t = pd.read_csv("t2t_chromosome_lengths.csv").rename(columns={'Length': 'T2T_Length'})

# 2. Unir y Filtrar datos
# Unir las longitudes por nombre de cromosoma
comparison_df = pd.merge(df_hg38, df_t2t, on='chrom', how='inner')

# Filtrar por cromosomas canónicos (1-22, X, Y)
standard_chroms = [f'chr{i}' for i in range(1, 23)] + ['chrX', 'chrY']
comparison_df_filtered = comparison_df[comparison_df['chrom'].isin(standard_chroms)].set_index('chrom')

# Ordenar los cromosomas por longitud descendente de Hg38
comparison_df_filtered = comparison_df_filtered.sort_values(by='Hg38_Length', ascending=False)

# 3. Preparar datos para el gráfico
chromosomes = comparison_df_filtered.index
hg38_lengths = comparison_df_filtered['Hg38_Length']
t2t_lengths = comparison_df_filtered['T2T_Length']

# 4. Configuración del gráfico de barras agrupadas
x = np.arange(len(chromosomes)) # Posiciones para los cromosomas
width = 0.35 # Ancho de las barras

plt.figure(figsize=(14, 7))
ax = plt.gca() # Obtener los ejes actuales
# Barras para Hg38
rects1 = ax.bar(x - width/2, hg38_lengths, width, label='Hg38 (RefSeq)', color='skyblue')
# Barras para T2T
rects2 = ax.bar(x + width/2, t2t_lengths, width, label='T2T (NCBI)', color='coral')

# 5. Etiquetas y formato
ax.set_title('Comparación de la Longitud Estimada de Cromosomas (Hg38 vs. T2T)', fontsize=16)
ax.set_ylabel('Longitud (Pares de Bases)', fontsize=12)
ax.set_xlabel('Cromosoma', fontsize=12)
ax.set_xticks(x)
ax.set_xticklabels(chromosomes, rotation=45, ha='right')
ax.legend(loc='upper right')
ax.grid(axis='y', linestyle='--', alpha=0.7)

# Formatear el eje Y para mostrar valores en millones (ej. 200M)
def millions_formatter(x, pos):
    return f'{x*1e-6:,.0f}M'
ax.yaxis.set_major_formatter(FuncFormatter(millions_formatter))

plt.tight_layout()
plt.show() # Usar show() en Colab para mostrar el gráfico

import pandas as pd
import matplotlib.pyplot as plt
import numpy as np
from matplotlib.ticker import FuncFormatter

# Suposición: Los archivos de datos originales ('Hg38(1).csv' y 'T2T_NCBI2.csv')
# ya han sido cargados en el entorno de Colab.

# 1. Cargar datos
df_hg38 = pd.read_csv("Hg38(1).csv")
df_t2t = pd.read_csv("T2T_NCBI2.csv")

# Limpieza de nombres de columna para T2T
df_t2t.columns = df_t2t.columns.str.replace(r'[#"]', '', regex=True).str.strip()

# 2. Calcular Desvío Estándar por Cromosoma
# El DS mide la dispersión de las posiciones finales de las características anotadas.
# Hg38: DS de 'txEnd'
hg38_std = df_hg38.groupby('chrom')['txEnd'].std().rename('Hg38_StdDev')
# T2T: DS de 'chromEnd'
t2t_std = df_t2t.groupby('chrom')['chromEnd'].std().rename('T2T_StdDev')

# 3. Unir, Filtrar y Ordenar
std_comparison_df = pd.merge(hg38_std, t2t_std, on='chrom', how='inner').reset_index()
standard_chroms = [f'chr{i}' for i in range(1, 23)] + ['chrX', 'chrY']
std_comparison_df_filtered = std_comparison_df[std_comparison_df['chrom'].isin(standard_chroms)].set_index('chrom')
std_comparison_df_filtered = std_comparison_df_filtered.sort_values(by='Hg38_StdDev', ascending=False)

# 4. Configuración del gráfico de barras agrupadas
chromosomes = std_comparison_df_filtered.index
hg38_std_devs = std_comparison_df_filtered['Hg38_StdDev']
t2t_std_devs = std_comparison_df_filtered['T2T_StdDev']

x = np.arange(len(chromosomes))  # Posiciones para los cromosomas
width = 0.35  # Ancho de las barras

plt.figure(figsize=(14, 7))
ax = plt.gca()
rects1 = ax.bar(x - width/2, hg38_std_devs, width, label='Hg38 (txEnd StdDev)', color='darkblue')
rects2 = ax.bar(x + width/2, t2t_std_devs, width, label='T2T (chromEnd StdDev)', color='darkred')

# 5. Etiquetas y formato
ax.set_title('Comparación del Desvío Estándar de la Posición Final de Características Genómicas', fontsize=15)
ax.set_ylabel('Desvío Estándar (Pares de Bases)', fontsize=12)
ax.set_xlabel('Cromosoma', fontsize=12)
ax.set_xticks(x)
ax.set_xticklabels(chromosomes, rotation=45, ha='right')
ax.legend(loc='upper right')
ax.grid(axis='y', linestyle='--', alpha=0.7)

# Formatear el eje Y para mostrar valores en millones
def millions_formatter(x, pos):
    return f'{x*1e-6:,.1f}M'
ax.yaxis.set_major_formatter(FuncFormatter(millions_formatter))

plt.tight_layout()
plt.show()

